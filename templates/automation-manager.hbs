<div class="fam-body">
{{#if detail}}
    <header class="fam-detail-header">
        <button type="button" class="fam-back" data-action="backToList" aria-label="Назад"><i class="fa-solid fa-arrow-left"></i></button>
        <h2 class="fam-detail-name">{{detail.name}}</h2>
    </header>
    <div class="fam-detail-tags"><span class="fam-tag">{{detail.author}}</span><span class="fam-tag">v{{detail.revision}}</span>{{#if detail.byName}}<span class="fam-tag">Збіг назви</span>{{/if}}</div>
    {{#if detail.changed}}<p class="hint">Код публікації відрізняється від вашої копії.</p>{{/if}}
    <label class="fam-public-code-label">Код макроса<textarea class="fam-public-code" readonly spellcheck="false" aria-label="Код публічної автоматизації">{{detail.command}}</textarea></label>
    <button type="button" class="fam-big-toggle fam-big-toggle-apply" data-action="applyPublic" data-automation-id="{{detail.key}}" {{#if detail.locked}}disabled{{/if}} {{#if detail.active}}disabled{{/if}} {{#if busy}}disabled{{/if}}>{{detail.applyLabel}}</button>
    {{#if detail.locked}}<p class="hint">Для застосування потрібні права власника предмета та Script-макросів.</p>{{/if}}
    {{#if detail.canDisable}}<button type="button" data-action="disableCopy">Вимкнути копію на предметі</button>{{/if}}
    {{#if detail.canUnpublish}}<button type="button" data-action="unpublish" data-automation-id="{{detail.key}}">Зняти публікацію</button>{{/if}}
{{else}}
    <div class="fam-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" value="{{search}}" placeholder="Назва або автор" aria-label="Пошук автоматизацій" autocomplete="off"></div>
    <ul class="fam-list">{{#each rows}}
        <li class="fam-row {{#if active}}fam-row-active{{/if}}" data-search="{{searchText}}">
            <button type="button" class="fam-public-row" data-action="openAutomation" data-automation-id="{{key}}">
                <i class="fam-row-icon fa-solid {{#if active}}fa-circle-check{{else}}fa-code{{/if}}"></i>
                <span class="fam-info"><span class="fam-name">{{name}}</span><span class="fam-tags"><span class="fam-tag">{{author}}</span>{{#if byName}}<span class="fam-tag">Збіг назви</span>{{/if}}</span></span>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </li>
    {{else}}<li class="fam-empty">Публічних автоматизацій ще немає. Опублікуйте макрос через Manage Macros → Public automation.</li>{{/each}}</ul>
{{/if}}
</div>
